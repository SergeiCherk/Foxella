# Copy to .env and fill in. Never commit .env.
BOT_TOKEN=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=qwen3.8-flash

# Your Telegram id (several: 123,456) for the /admin statistics. Empty: nobody.
ADMIN_IDS=

# Without LLM_API_KEY or LLM_BASE_URL the bot still works: it uses its own ready-made dishes.
#
# The base URL and the model id depend on the provider. Examples taken from the providers' docs
# (check the current docs before use):
#   Novita   LLM_BASE_URL=https://api.novita.ai/openai          LLM_MODEL=qwen/qwen3.8-flash
#   Venice   LLM_BASE_URL=https://api.venice.ai/api/v1          LLM_MODEL=qwen-3-8-flash
#   Requesty LLM_BASE_URL=https://router.requesty.ai/v1         LLM_MODEL=alibaba/qwen3.8-flash
#   Alibaba Cloud Model Studio: the URL contains your workspace id, see its docs.
#
# Provider-specific request options as JSON, for example to switch thinking off on providers that
# support the DashScope extension:
# LLM_EXTRA_BODY={"enable_thinking": false}
#
# DATABASE_URL=sqlite+aiosqlite:///./nutrition_bot.db
# LOG_LEVEL=INFO
